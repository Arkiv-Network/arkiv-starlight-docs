# The feedback API (server.ts), routed at docs.arkiv.network/api/*.
#   docker build -f Dockerfile.feedback -t ghcr.io/arkiv-network/arkiv-docs-feedback:prod .
FROM oven/bun:1.4.4-alpine@sha256:4cf82f5686b196504fe119db3fcd9185b191f82ece82c40680e597228ec6070a
WORKDIR /app
COPY server.ts ./
USER bun
EXPOSE 3000
CMD ["bun", "run", "/app/server.ts"]
